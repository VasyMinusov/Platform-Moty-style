# ═══════════════════════════════════════════════════════════════════════
# Auth-service — локальные секреты
#
# Переменные, которые переопределяются через docker-compose (POSTGRES_*,
# JWT_SECRET_KEY, CORS_ORIGINS и т.д.), здесь можно не задавать — они
# придут из environment секции docker-compose.yml.
#
# Обязательно здесь: только ENCRYPTION_KEY.
# ═══════════════════════════════════════════════════════════════════════

# 32 байта в base64. Генерация: openssl rand -base64 32
ENCRYPTION_KEY=replace_me_with_openssl_rand_base64_32

# Остальное переопределяется в docker-compose.yml:
# POSTGRES_*
# JWT_SECRET_KEY  (общий с ctf-backend)
# JWT_ISSUER, JWT_AUDIENCE
# RATE_LIMIT_BACKEND
# OAUTH_ENABLED
# CORS_ORIGINS, TRUSTED_HOSTS
# METRICS_*, HIBP_*, SMTP_*